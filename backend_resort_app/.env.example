# ==================================
# SERVER
# ==================================
PORT=3000
BASE_URL=http://localhost:3000

# Optional: rewrite stored /uploads/... paths to Cloudinary delivery URLs.
# Example: https://res.cloudinary.com/<cloud_name>/image/upload
CLOUDINARY_BASE_URL=

# ==================================
# DATABASE (MySQL)
# ==================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=resort_db

# ==================================
# JWT
# ==================================
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d

# ==================================
# EMAIL (Nodemailer - Gmail example)
# ==================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# ==================================
# OTP
# ==================================
OTP_EXPIRE_MINUTES=5

# ==================================
# SEPAY (Webhook)
# ==================================
SEPAY_API_KEY=your_super_secret_sepay_key
